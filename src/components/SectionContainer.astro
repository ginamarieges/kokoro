---
interface Props {
  id: string,
  title?: string,
  class?: string
}
const {id, title, class: className } = Astro.props;
---
<section id={id} class={`px-10 gap-4 mx-auto w-full py-10 sm:px-20 md:px-40 ${className}`}>
  <slot name="icon"></slot>
  {title && (
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-4xl font-bold text-[#FFD483]">{title}</h2>
    </div>
  )}
  <slot/>
</section>
