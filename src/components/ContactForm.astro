  <form name="contact" method="POST" data-netlify="true" autocomplete="off" class="flex flex-col gap-2">
    <input type="hidden" name="form-name" value="contact" />
    <input type="text" name="fullname" placeholder="Nom complet" class=" border border-[#FFD483] px-4 py-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#FFD483]">
    <input type="email" name="email" placeholder="Email" class=" border border-[#FFD483] px-4 py-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#FFD483]">
    <textarea name="message" placeholder="Missatge" class=" border border-[#FFD483] px-4 py-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#FFD483]" rows="6"></textarea>
    <button type="submit" class="w-full sm:w-auto bg-[#FFD483] border border-[#FFD483] text-white px-4 py-2 rounded-xl cursor-pointer hover:text-[#977b5f] transition">Enviar</button>
    <span class="text-[#977b5f] text-start text-pretty">Llegim tots els missatges amb calma i cura, i sempre intentem respondre al més aviat possible</span>
  </form>
