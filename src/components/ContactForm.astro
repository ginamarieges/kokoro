  <form name="contact" method="POST" data-netlify="true" autocomplete="off" class="flex flex-col gap-2">
    <input type="hidden" name="form-name" value="contact" />
    <input type="text" name="fullname" placeholder="Nom complet" class=" border border-[#FFD482] px-4 py-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#FFD482]">
    <input type="email" name="email" placeholder="Email" class=" border border-[#FFD482] px-4 py-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#FFD482]">
    <textarea name="message" placeholder="Missatge" class=" border border-[#FFD482] px-4 py-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#FFD482]" rows="6"></textarea>
    <button type="submit" class="w-full sm:w-auto border border-[#FFD482] text-[#FFD482] px-4 py-2 rounded-xl cursor-pointer hover:bg-[#FFD482] hover:text-white transition">Enviar</button>
  </form>
