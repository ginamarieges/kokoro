---
import "../styles/global.css";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from "../components/BackToTop.astro";
import 'aos/dist/aos.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Kokoro Cub – a sensory toy cube designed for autistic children. Encourages emotional regulation, focus, and joyful play." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{ title }</title>
	</head>
	<body class="min-h-screen flex flex-col">
		<script>
      import AOS from "aos";
      AOS.init({
      offset: 200,
      duration: 400,
      easing: 'ease-in-sine',
    });
    </script>
		<Header/>
			<main class="flex-1">
				<slot />
				<BackToTop/>
			</main>
    <Footer/>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		min-height: 100dvh;
		background: #fff6ea;
	}
</style>
