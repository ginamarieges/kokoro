---
import ContactForm from '../components/ContactForm.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <main class="pt-35 pb-12 sm:pt-36">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <section class="max-w-5xl mx-auto">
        <div class="mb-10 text-center space-y-3 px-2">
          <h2 class="text-[#FFD482] text-4xl sm:text-5xl lg:text-6xl font-semibold leading-tight">
            Vols un cub?
          </h2>
          <h3 class="text-[#FFD482] text-xl sm:text-2xl lg:text-3xl">
            Contacta amb nosaltres!
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-9 gap-6 md:gap-8 items-start md:items-stretch">
          <div class="flex flex-col sm:justify-center md:col-span-4 w-full min-w-0">
            <ul class="space-y-3 break-words">
              <li class="bg-[#FFD482] rounded-xl px-4 py-2">✉️ <a href="mailto:kokorojoguines@gmail.com">kokorojoguines@gmail.com</a></li>
              <li class="bg-[#FFD482] rounded-xl px-4 py-2">
                <a
                  href="https://www.instagram.com/kokoro.joguines/"
                  aria-label="Kokoro instagram profile"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  /kokorojoguines 
                </a>
              </li>
              <li class="bg-[#FFD482] rounded-xl px-4 py-2">☎️ <a href="tel:+34675353632">675 35 36 32</a></li>
            </ul>
          </div>

          <div class="flex items-center justify-center md:col-span-1 my-4 md:my-0">
            <span class="text-[#FFD482] select-none">o</span>
          </div>

          <div class="md:col-span-4 w-full min-w-0">
            <ContactForm/>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>
