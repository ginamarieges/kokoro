---
import ContactForm from '@/components/ContactForm.astro';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Contact">
  <div class="pt-16 sm:p-0">
    <div class="mx-auto">
      <section class="p-10 sm:px-20 lg:px-40 flex flex-col gap-10 min-h-screen md:grid md:grid-cols-5 gap-4 items-stretch">
        <div class="bg-[url('/images/contacte-kokoro.png')] bg-cover bg-center col-span-2 h-full min-h-[20rem]"></div>
        <div class="sm:flex flex-col md:col-span-3">
          <div class="text-center">
            <h2 class="mb-4 text-[#FFD483] text-3xl md:text-4xl font-bold leading-tight">
              Vols un cub?
            </h2>
            <p class="mb-3 text-[#977b5f] text-lg md:text-xl text-wrap">
              Si tens dubtes, curiositats o t’agradaria aconseguir el Cub Kokoro, escriu-nos. Ens encanta conversar i acompanyar de manera propera
            </p>
          </header>
          <div class="mx-auto w-full max-w-lg">
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

